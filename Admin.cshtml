
@model IEnumerable<YourProjectName.Models.Insuree>

@{
    ViewBag.Title = "Admin";
}

<h2>Admin - All Insurance Quotes</h2>

<p>
    Below is a list of all insurance quotes that have been issued.
</p>

<table class="table table-bordered table-striped">

    <thead>
        <tr>
            <th>
                First Name
            </th>

            <th>
                Last Name
            </th>

            <th>
                Email Address
            </th>

            <th>
                Quote
            </th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.FirstName)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.LastName)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.EmailAddress)
                </td>

                <td>
                    @item.Quote.ToString("C")
                </td>
            </tr>
        }
    </tbody>

</table>

<p>
    @Html.ActionLink("Create New Insuree", "Create")
</p>

